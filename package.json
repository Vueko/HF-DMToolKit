{
  "name": "hf-gm-toolkit",
  "private": true,
  "version": "1.1.0",
  "description": "Independent desktop toolkit for fantasy tabletop game masters.",
  "author": "Carlos",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently \"vite\" \"tsc -p tsconfig.electron.json && wait-on tcp:5173 && electron .\"",
    "build": "tsc -b && vite build",
    "build:electron": "vite build && tsc -p tsconfig.electron.json",
    "dist:win": "npm run build:electron && electron-builder --win",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.2.8",
    "@fontsource/inter": "^5.2.8",
    "@tanstack/react-virtual": "^3.14.5",
    "dompurify": "^3.4.12",
    "electron-updater": "^6.8.9",
    "immer": "^10.2.0",
    "mammoth": "^1.12.0",
    "pdfjs-dist": "^6.1.200",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "^10.1.0",
    "react-router": "8.3.0",
    "remark-gfm": "^4.0.1",
    "yaml": "^2.9.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "^4.2.4",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "10.0.4",
    "electron": "^43.1.0",
    "electron-builder": "26.15.3",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "^17.5.0",
    "tailwindcss": "^4.2.4",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.65.0",
    "vite": "^8.0.9",
    "vitest": "^3.2.6",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.hfgmtoolkit.app",
    "productName": "HF GM Toolkit",
    "copyright": "Copyright © 2025 Carlos",
    "publish": [
      {
        "provider": "github",
        "owner": "Vueko",
        "repo": "HF-DMToolKit"
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "icon": "public/icon.ico",
      "artifactName": "HF-GM-Toolkit-Setup-${version}.exe",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "extraResources": [
      {
        "from": "resources/sounds",
        "to": "sounds"
      }
    ]
  },
  "overrides": {
    "@electron/asar": "4.2.1",
    "@electron/universal": "3.0.6",
    "jake": "12.10.1",
    "filelist": "2.0.2",
    "rimraf": "6.1.3"
  }
}
