{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "lib": ["ES2022"],
    "rootDir": "electron",
    "outDir": "dist-electron",
    "types": ["node"],
    "skipLibCheck": true,
    "strict": true,
    "esModuleInterop": true,
    "incremental": true,
    "tsBuildInfoFile": "node_modules/.cache/tsconfig.electron.tsbuildinfo"
  },
  "include": ["electron/**/*"],
  // Tests are run by Vitest (own transform), so they must not be emitted into
  // dist-electron — electron-builder ships that folder into the packaged app.
  "exclude": ["electron/**/*.test.ts"]
}